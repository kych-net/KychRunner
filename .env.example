# /etc/kychrunner/env —— 由 systemd EnvironmentFile 加载
# 模式 B：只有 runner token，没有数据库凭据、没有 DSN、没有 LFS_ROOT。

KYCHNET_URL=https://kych.net

# `kychrunner register` 回显一次，之后服务端只存 SHA-256 hash。
RUNNER_TOKEN=replace-me

RUNNER_NAME=kychrunner
RUNNER_LABELS=self-hosted,linux

ACT_BIN=/usr/local/bin/act
WORK_ROOT=/var/lib/kychrunner/runs
ACTIONS_DIR=/opt/kychrunner/actions
ACT_CACHE=/var/lib/kychrunner/act-cache
RUNNER_IMAGE=kychnet/act-runner:1

HEARTBEAT_SECS=60
CLAIM_TIMEOUT_SECS=30
MAX_SNAPSHOT_BYTES=209715200
MAX_LOG_BYTES=8388608
JOB_TIMEOUT_SECS=900

# RUST_LOG=kychrunner=debug
